# Al-Hifz server environment — PLACEHOLDERS ONLY. Never commit real values.
# Set the real values in the Vercel dashboard (Project → Settings →
# Environment Variables). See PUSH_NOTIFICATIONS_SETUP.md.

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Protects /api/push/cron. Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" when this env var exists.
CRON_SECRET=

# Existing datastore (already used by /api/stats) — also stores push subscriptions.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
