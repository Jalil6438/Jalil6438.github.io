# Al-Hifz server environment — PLACEHOLDERS ONLY. Never commit real values.
# Set real values in the Vercel dashboard (Project → Settings → Environment
# Variables). Full setup + verification: PUSH_NOTIFICATIONS_SETUP.md.
#
# ⚠ PROJECT ISOLATION: this repository feeds TWO Vercel projects.
#   - Al-Hifz project:        set the variables below as documented.
#   - noortech-share project: set NONE of the ALHIFZ_* gates (leave absent).
#     With the gates absent, every notification route is a safe no-op there.

# ── DEPLOYMENT FEATURE GATES (server-only; never NEXT_PUBLIC_/VITE_) ────────
# Purpose:       master switch for push subscription writes, test sends, and
#                VAPID usage. Only the exact lowercase string "true" enables;
#                missing/blank/"TRUE"/"1"/"yes" are all treated as DISABLED.
# Server-only:   yes (read via process.env in api/ functions only)
# Preview:       required "true" in the Al-Hifz project IF previews should push
# Production:    required "true" in the Al-Hifz project
# When absent:   push APIs return a neutral disabled response; no storage
#                reads/writes, no sends, no VAPID use (safe default)
# Which project: Al-Hifz ONLY — must stay absent/false in noortech-share
ALHIFZ_PUSH_ENABLED=

# Purpose:       master switch for the scheduled reminder cron (/api/push/cron).
#                Exact "true" enables; anything else → the cron is a safe
#                successful no-op (no reads, no writes, no dedupe keys, no sends).
# Server-only:   yes
# Preview:       optional (Vercel crons only run on production anyway; set
#                "true" only if you trigger the endpoint manually on previews)
# Production:    required "true" in the Al-Hifz project
# When absent:   cron returns 200 {enabled:false, noop:true} — no errors, no work
# Which project: Al-Hifz ONLY — must stay absent/false in noortech-share
ALHIFZ_CRON_ENABLED=

# Purpose:       master switch for the progress SHADOW BACKUP (Phase 1). Only the
#                exact lowercase string "true" enables; missing/blank/"TRUE"/"1"/
#                "yes" are all DISABLED. Shadow only — the server never reads back,
#                merges, or restores progress; localStorage stays the source of truth.
# Server-only:   yes (read via process.env in api/progress/* only; never NEXT_PUBLIC_)
# Preview:       set "true" ONLY to validate on a Preview deployment
# Production:    leave BLANK for now — do not enable until Preview validation passes
# When absent:   /api/progress/backup returns a neutral disabled response with NO
#                datastore access; the client makes no backup request (safe default)
# Namespace:     stores under alhifz:progress-backup:v1: (isolated from push/stats)
# Which project: Al-Hifz ONLY — must stay absent/false in noortech-share
ALHIFZ_PROGRESS_BACKUP_ENABLED=

# ── WEB PUSH (VAPID) — generate with: npx web-push generate-vapid-keys ─────
# Purpose:       VAPID keypair authenticating server push sends; the public key
#                is served to clients by /api/push/config, the private key
#                never leaves the server.
# Server-only:   VAPID_PRIVATE_KEY yes (secret); VAPID_PUBLIC_KEY is public by
#                design but still served from the server (not baked into the bundle)
# Preview:       required if previews should push
# Production:    required
# When absent:   push/test routes answer "not configured"; nothing sends
# Which project: Al-Hifz ONLY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Purpose:       contact URI required by the Web Push spec (mailto: or https:)
# Server-only:   yes | Preview: with the keys | Production: required
# When absent:   sender treats VAPID as unconfigured (no sends)
# Which project: Al-Hifz ONLY
VAPID_SUBJECT=

# ── CRON AUTH ────────────────────────────────────────────────────────────────
# Purpose:       bearer secret protecting /api/push/cron; Vercel Cron attaches
#                "Authorization: Bearer <CRON_SECRET>" automatically when set.
# Server-only:   yes (secret)
# Preview:       optional (only for manual cron testing on previews)
# Production:    strongly recommended in the Al-Hifz project
# When absent:   the cron endpoint (when ALHIFZ_CRON_ENABLED=true) accepts
#                unauthenticated GETs — set this before enabling the cron gate
# Which project: Al-Hifz ONLY
CRON_SECRET=

# ── UPSTASH REDIS (existing datastore; also stores push subscriptions) ──────
# Purpose:       REST endpoint + token for stats counters and push subscription
#                records / dedupe keys.
# Server-only:   yes (token is a secret)
# Preview:       required if previews should use stats/push storage
# Production:    required
# When absent:   stats return zeros; push storage reports "not configured"
# Which project: already configured where /api/stats runs; push additionally
#                requires the ALHIFZ_PUSH_ENABLED gate, so setting these in
#                noortech-share does NOT enable notifications there
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
