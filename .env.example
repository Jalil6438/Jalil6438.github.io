# Al-Hifz backend environment — PLACEHOLDERS ONLY. Real values live in the
# Vercel project env settings; never commit a filled-in copy (.env is
# gitignored and release:check blocks tracked env files).

# ── Web push (background reminders) ──
# Generate a keypair once with: npx web-push generate-vapid-keys
# The PUBLIC key is served to browsers via /api/push/key; the PRIVATE key
# signs pushes server-side and must never reach the client bundle.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for push-service operators.
VAPID_SUBJECT=

# Bearer token protecting /api/cron/send-reminders. Vercel Cron sends
# "Authorization: Bearer $CRON_SECRET" automatically when this is set; QStash
# or any other scheduler must be configured with the same header. The endpoint
# fails closed (503) when unset.
CRON_SECRET=

# Durable reminder control plane migration gate. Keep false in Production until
# hosted Preview Redis/QStash verification and explicit founder authorization.
REMINDER_CONTROL_PLANE_ENABLED=false

# ── Existing datastore (also used by /api/stats) ──
# Upstash Redis REST credentials; push subscriptions, dedupe markers, and the
# delivery log live here alongside the public stats counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Durable progress backup (disabled unless explicitly enabled).
# Preview and Production require adapter=redis, both Redis credentials, a
# server-only pepper of at least 16 characters, and their own VERCEL_ENV scope.
# Use separate Redis credentials where possible; key namespaces also isolate
# development, Preview, and Production. Never expose token or pepper to Vite.
BACKUP_ENABLED=false
BACKUP_STORE_ADAPTER=redis
BACKUP_REDIS_REST_URL=
BACKUP_REDIS_REST_TOKEN=
BACKUP_IP_PEPPER=

# Durable recovery orchestration gate. Missing/false keeps every recovery route
# disabled. Enable in Preview only after independent audit and Redis validation.
PROGRESS_RECOVERY_PLATFORM_ENABLED=false
VITE_PROGRESS_RECOVERY_ENABLED=false
# Preview smoke guard and target; never set either to Production.
RECOVERY_PREVIEW_CONFIRM=
RECOVERY_PREVIEW_URL=
